{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awenda-jewelry",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://awenda-jewelry.awenda.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://hperhbuskneblwuyeowq.supabase.co",
    "EMBEDDINGS_PROVIDER": "voyage",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhwZXJoYnVza25lYmx3dXllb3dxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk1NTY1MDgsImV4cCI6MjEwNTEzMjUwOH0.hDbv6A0gs4Q33hDB6Ar8R83GIgWxMSYz8YdcrwAFswg",
    "NEXT_PUBLIC_CF_BEACON_TOKEN": "919d508e35ec4c47920045cdeed76dc0"
  },
  "triggers": {
    // "0 6 * * *": keepalive, daily at 06:00 UTC.
    // "0 14 * * *": pickup-reminders, daily at 14:00 UTC = 09:00
    // America/New_York during EDT (market timezone default, settings.market_timezone).
    // Cloudflare Cron Trigger expressions are fixed UTC — there is no DST-aware
    // cron here, so this drifts to 10:00 local once EST starts in November;
    // acceptable for a once-daily reminder, revisit if it matters.
    "crons": ["0 6 * * *", "0 14 * * *"]
  }
}
