{
  "name": "awenda-jewelry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm cf-typegen && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && pnpm cf-typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "sh scripts/deploy.sh",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "seed:admins": "tsx --env-file=.env.local scripts/seed-admins.ts",
    "embed:check": "tsx --env-file=.env.local scripts/embed-check.ts",
    "stripe:check": "tsx --env-file=.env.local scripts/stripe-check.ts"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "exifr": "^7.1.3",
    "jpeg-js": "^0.4.4",
    "piexifjs": "^1.0.6",
    "prettier": "^3",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  },
  "packageManager": "pnpm@9.15.9"
}
