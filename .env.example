# Supabase project URL (client + server)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key, RLS enforced (client + server)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key, server only (webhook, cron, embeddings) — never ship to client
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated allowlist of admin login emails (server)
ADMIN_EMAILS=
# Voyage AI API key (server)
VOYAGE_API_KEY=
# Embeddings provider: voyage | fake (tests/CI) (server)
EMBEDDINGS_PROVIDER=
# Stripe secret key: test key locally, live key in prod (server)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret, from Stripe dashboard / `stripe listen` (server)
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key (client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Resend API key (server)
RESEND_API_KEY=
# Verified sender, e.g. "Awenda Jewelry <orders@…>" — needs verified domain, Phase 9 (server)
EMAIL_FROM=
# Site URL, e.g. http://localhost:3000 locally (client + server)
NEXT_PUBLIC_SITE_URL=
# Shared secret protecting the keepalive cron endpoint (server)
CRON_SECRET=
